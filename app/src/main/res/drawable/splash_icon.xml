<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ start-up splash icon (values-v31/themes.xml): deliberately empty, so the system's
     splash is just the dark backdrop. MainActivity's own splash (Splash.kt) then shows the logo with
     its progress bar on the same backdrop. Without an icon of its own Android would show the
     launcher icon, so this transparent square stands in for one. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <size android:width="288dp" android:height="288dp" />
</shape>
