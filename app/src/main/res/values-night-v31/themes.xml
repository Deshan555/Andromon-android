<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ (dark mode too: "night" outranks "v31", so this copy is needed): the system's start-up splash is just the dark backdrop (splash_icon is empty and there is no branding image); MainActivity then shows the logo and its progress bar on it (Splash.kt). -->
    <style name="LaunchTheme" parent="AppTheme">
        <item name="android:windowSplashScreenBackground">@color/splash_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowBackground">@drawable/splash_window</item>
    </style>
</resources>
